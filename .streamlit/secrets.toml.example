# Template for .streamlit/secrets.toml (Streamlit Cloud: Settings → Secrets)
# Copy to .streamlit/secrets.toml for local dev — the real file is gitignored
# and must NEVER be committed.

# Required — Anthropic (Claude) API key. The app is Anthropic-only.
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional — set to enable the app-level passcode gate.
# When unset or empty, the app loads without a passcode prompt.
APP_PASSCODE = ""
